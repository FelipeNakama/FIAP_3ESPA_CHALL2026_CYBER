# ==============================================================
# HábitoPlus — CarePlus
# Arquivo de exemplo de variáveis de ambiente
#
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado .env
# 2. Preencha os valores reais no arquivo .env
# 3. NUNCA commite o arquivo .env no repositório
# 4. O arquivo .env já está listado no .gitignore
# ==============================================================


# --- Banco de Dados ---
# String de conexão completa com o banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco


# --- Autenticação JWT ---
# Chave secreta usada para assinar e verificar tokens JWT
# Deve ter no mínimo 64 caracteres gerados aleatoriamente
JWT_SECRET_KEY=sua-chave-jwt-aqui-minimo-64-caracteres


# --- APIs Externas ---
# Chave de API do serviço de notificações push
API_KEY_NOTIFICACOES=sua-api-key-de-notificacoes-aqui

# Chave de API do sistema de recompensas parceiro
API_KEY_RECOMPENSAS=sua-api-key-de-recompensas-aqui


# --- Configurações do Ambiente ---
# Ambiente de execução: development, staging ou production
APP_ENV=development

# Porta em que o servidor vai rodar localmente
APP_PORT=8000
